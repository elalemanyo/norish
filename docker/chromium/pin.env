# The fingerprint-chromium build Norish ships.
#
# This file records what the image contains: the upstream release it
# repackages, and the tag Norish publishes it under. Bump both and move the
# Compose example to the new tag. The push runs the **Publish Chromium image**
# workflow.
#
# Shell-sourceable on purpose: `set -a; . docker/chromium/pin.env; set +a`.

CHROMIUM_REPO=https://github.com/adryfish/fingerprint-chromium
# Keep these three in step with the Dockerfile's ARG defaults, so a bare
# `docker build docker/chromium` builds what the workflow publishes. The archive
# name changes shape between releases, so it is recorded rather than derived.
CHROMIUM_VERSION=150.0.7871.186
CHROMIUM_ARCHIVE=ungoogled-chromium-150.0.7871.186-1-x86_64_linux.tar.xz
CHROMIUM_SHA256=48eff860053efd9ad498d51370f0a1f59f983df39c02a72ad2a8682cdead4055

CHROMIUM_IMAGE=docker.io/norishapp/chromium
# `<upstream version>-norish.<build>`: the build counter moves when the image
# changes without the upstream release moving (a Dockerfile or base-image fix).
CHROMIUM_IMAGE_TAG=150.0.7871.186-norish.1
